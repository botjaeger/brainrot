{
  "name": "brainrot",
  "private": true,
  "license": "MIT",
  "version": "0.1.5",
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "scripts": {
    "build": "pnpm run build:all",
    "build:base": "vite build",
    "build:chromium": "pnpm run build:base && node scripts/package-browser-builds.mjs chromium",
    "build:firefox": "pnpm run build:base && node scripts/package-browser-builds.mjs firefox",
    "build:safari": "pnpm run build:base && node scripts/package-safari-builds.mjs safari",
    "build:all": "pnpm run build:base && node scripts/package-browser-builds.mjs all && node scripts/package-safari-builds.mjs safari",
    "firefox:run": "web-ext run --source-dir dist/firefox",
    "firefox:build": "web-ext build --source-dir dist/firefox",
    "safari:build": "pnpm run build:safari && node scripts/build-safari-app.mjs",
    "safari:build:signed": "pnpm run build:safari && node scripts/build-safari-app.mjs --signed",
    "chrome:zip": "pnpm run build && node scripts/zip-chrome.mjs",
    "firefox:zip": "pnpm run build && node scripts/zip-firefox.mjs",
    "safari:run": "pnpm run safari:build && open /tmp/brainrot-safari/Build/Products/Debug/Brainrot.app",
    "safari:run:signed": "pnpm run safari:build:signed && open /tmp/brainrot-safari/Build/Products/Debug/Brainrot.app",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm run build:chromium && playwright test",
    "typecheck": "tsc --noEmit && pnpm --filter brainrot-site typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "release": "node scripts/release.mjs",
    "dev:site": "pnpm --filter brainrot-site dev",
    "build:site": "pnpm --filter brainrot-site build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/chrome": "^0.1.40",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.10.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.5",
    "web-ext": "^10.2.0"
  }
}
