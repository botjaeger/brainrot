{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "types": ["node", "vitest/globals", "chrome"]
  },
  "include": ["src", "tests", "site", "vite.config.ts", "vite.site.config.ts", "vitest.config.ts"],
  "exclude": ["dist", "node_modules"]
}
